# 飞书应用凭证（在 https://open.feishu.cn/app 创建应用获取）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书多维表格 Base Token
# 从多维表格URL中获取：https://xxx.feishu.cn/base/{FEISHU_BASE_TOKEN}?table=...
FEISHU_APP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 对标账号库 表ID
ACCOUNT_TABLE_ID=tblxxxxxxxxxxxxxxxxxxx

# 对标作品库 表ID
WORKS_TABLE_ID=tblxxxxxxxxxxxxxxxxxxx

# 阿里百炼 API Key（Paraformer 转写引擎用，可选）
# 在 https://dashscope.aliyun.com 获取
# 不填则只能使用 Whisper 离线转写
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 阿里百炼 API 地址（可选，使用自定义地址时填写）
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/api/v1
